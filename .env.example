# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://repro:repro@localhost:5432/repro

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Provider (OpenAI-compatible) ────────────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Sandbox Limits ───────────────────────────────────────────────────────────
SANDBOX_CPU_QUOTA=50000        # 50% of one CPU (Docker cpu-quota)
SANDBOX_MEM_LIMIT=512m         # container memory limit
SANDBOX_TIMEOUT_MS=120000      # 2 minutes per run total
SANDBOX_IMAGE=node:20-alpine   # base image for sandboxes

# ── Agent ────────────────────────────────────────────────────────────────────
AGENT_MAX_ATTEMPTS=5
AGENT_MAX_TOKENS=32000
