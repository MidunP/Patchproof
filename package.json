{
  "name": "repro",
  "version": "0.1.0",
  "description": "Automated bug reproduction and patching agent for GitHub issues",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": ["agent", "github", "reproduction", "testing"],
  "author": "",
  "license": "MIT"
}
